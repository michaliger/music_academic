PORT=4000
# MongoDB Atlas: Connect > Drivers > העתיקי את מחרוזת החיבור (ושימי סיסמה ושם DB)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/music_academy?retryWrites=true&w=majority
# לפיתוח מקומי עם docker compose:
# MONGODB_URI=mongodb://localhost:27017/music_academy
JWT_SECRET=change-me-to-a-long-random-string
# השאירי ריק כדי להשתמש במנוע השיעורים המובנה (Mock)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ADMIN_PHONE=0500000000
ADMIN_PASSWORD=admin1234
