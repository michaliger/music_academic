PORT=4000
# MongoDB Atlas: Connect > Drivers > copy the connection string (fill user, password and DB name).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/music_academy?retryWrites=true&w=majority
# Local alternative (docker compose up -d):
# MONGODB_URI=mongodb://localhost:27017/music_academy
JWT_SECRET=change-me-to-a-long-random-string
# AI (optional). Gemini key from https://aistudio.google.com/apikey. Paste it as is: no quotes, no spaces.
# Leave empty to use the built-in demo AI (same interface, canned answers). Check with: npm run ai:check
GEMINI_API_KEY=
# Optional: several keys (from separate Google projects), comma separated. When one runs out of quota the next one is used.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash
# Alternative provider (used only when no Gemini key is set):
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Admin account created on first start. Change before deploying.
ADMIN_PHONE=0500000000
ADMIN_PASSWORD=admin1234
